{
    "name": "sidus/filter-bundle",
    "description": "Simple yml-configuration-based filtering with Doctrine ORM abstraction",
    "keywords": [
        "filter",
        "doctrine",
        "sort",
        "datagrid"
    ],
    "homepage": "https://github.com/VincentChalnot/SidusFilterBundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vincent Chalnot",
            "email": "vincent@sidus.fr",
            "homepage": "https://sidus.fr",
            "role": "Developer"
        },
        {
            "name": "Madeline Veyrenc",
            "email": "mveyrenc@clever-age.com",
            "homepage": "https://github.com/mveyrenc",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sidus\\FilterBundle\\": ""
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.3",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/form": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/options-resolver": "^8.1",
        "symfony/property-access": "^8.1",
        "pagerfanta/core": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/framework-bundle": "^8.1",
        "doctrine/doctrine-bundle": "^3.0",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Sidus\\FilterBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
