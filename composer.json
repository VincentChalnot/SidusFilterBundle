{
    "name": "sidus/filter-bundle",
    "description": "Provider-agnostic list filtering, sorting and pagination: immutable definitions, per-request query handlers",
    "keywords": [
        "filter",
        "sort",
        "pagination",
        "datagrid",
        "list"
    ],
    "homepage": "https://github.com/VincentChalnot/SidusFilterBundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vincent Chalnot",
            "email": "vincent@sidus.fr",
            "homepage": "https://sidus.fr",
            "role": "Developer"
        },
        {
            "name": "Madeline Veyrenc",
            "email": "mveyrenc@clever-age.com",
            "homepage": "https://github.com/mveyrenc",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Sidus\\FilterBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "require": {
        "php": ">=8.4",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/options-resolver": "^8.1",
        "symfony/property-access": "^8.1"
    },
    "require-dev": {
        "pagerfanta/core": "^4.0",
        "phpunit/phpunit": "^12.0",
        "symfony/console": "^8.1",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/twig-bridge": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Sidus\\FilterBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "suggest": {
        "symfony/form": "Optional HTML form adapter",
        "symfony/http-foundation": "Optional HTTP request parser and result normalizer",
        "pagerfanta/core": "Optional Pagerfanta adapter",
        "symfony/console": "Enables the debug:sidus-filter command",
        "symfony/twig-bridge": "Form themes"
    }
}
